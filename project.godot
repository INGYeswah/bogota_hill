; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.2"

[application]

config/name="Bogotá Hill"
run/main_scene="res://Levels/level_1.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/window_width_override=1152
window/size/window_height_override=648
window/size/min_width=960
window/size/min_height=540

window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/rmsmartshape/plugin.cfg")

[global_group]

player=""
wheel=""

[input]

drive_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventKey,"keycode":4194319)]
}
drive_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventKey,"keycode":4194321)]
}
tilt_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventKey,"keycode":4194320)]
}
tilt_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":83), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventKey,"keycode":4194322)]
}
pause_run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":80), Object(InputEventKey,"keycode":80), Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"keycode":4194305)]
}
restart_run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventKey,"keycode":82)]
}
mute_audio={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77), Object(InputEventKey,"keycode":77)]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.5372549, 0.8352941, 0.9411765, 1)
